// =======================================================
// 超高速化インメモリキャッシュ (0ms応答エンジン)
// =======================================================
const MEMORY_CACHE = new Map();
const CACHE_TTL_MS = 10 * 60 * 1000; // 10分間キャッシュ

function getCached(key) {
  const item = MEMORY_CACHE.get(key);
  if (item && Date.now() - item.time < CACHE_TTL_MS) {
    return item.data;
  }
  return null;
}

function setCache(key, data) {
  if (MEMORY_CACHE.size > 300) {
    const firstKey = MEMORY_CACHE.keys().next().value;
    MEMORY_CACHE.delete(firstKey);
  }
  MEMORY_CACHE.set(key, { data, time: Date.now() });
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // --- 0. CORS & Cache 対応 ---
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "*",
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "public, max-age=180, s-maxage=600, stale-while-revalidate=86400"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const path = url.pathname;
    const cacheKey = url.pathname + url.search;

    const cachedData = getCached(cacheKey);
    if (cachedData && request.method === "GET") {
      return new Response(JSON.stringify(cachedData), { headers: corsHeaders });
    }

    // パラメータ解析
    let videoId = url.searchParams.get("v") || url.searchParams.get("videoId");
    let shortId = url.searchParams.get("short") || url.searchParams.get("shorts");
    let commentsVideoId = url.searchParams.get("comments") || url.searchParams.get("comment");
    let channelId = url.searchParams.get("channel") || url.searchParams.get("channelId");
    let playlistId = url.searchParams.get("playlist") || url.searchParams.get("playlistId");
    const query = url.searchParams.get("q") || url.searchParams.get("search");
    const isTrending = url.searchParams.has("trending") || path.startsWith("/api/v1/trending");
    const trendType = url.searchParams.get("type") || "default";
    const limit = Math.min(parseInt(url.searchParams.get("limit") || "30", 10), 60);
    const continuation = url.searchParams.get("continuation") || url.searchParams.get("token") || null;

    // パス判定
    const shortMatch = path.match(/^\/api\/v1\/shorts\/([a-zA-Z0-9_-]{11})/);
    if (shortMatch) shortId = shortMatch[1];
    const isShortsRoot = path === "/api/v1/shorts" || path === "/api/v1/shorts/";
    const videoMatch = path.match(/^\/api\/v1\/videos\/([a-zA-Z0-9_-]{11})/);
    if (videoMatch) videoId = videoMatch[1];
    const commentMatch = path.match(/^\/api\/v1\/comments\/([a-zA-Z0-9_-]{11})/);
    if (commentMatch) commentsVideoId = commentMatch[1];
    const channelMatch = path.match(/^\/api\/v1\/channels\/([^\/?#]+)/);
    if (channelMatch) channelId = channelMatch[1];
    const playlistMatch = path.match(/^\/api\/v1\/playlists\/([^\/?#]+)/);
    if (playlistMatch) playlistId = playlistMatch[1];

    try {
      // 1. トレンド・急上昇
      if (isTrending) {
        const data = await fetchTrendingVideosReliable(trendType);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 2. ショート動画 (超高速 & 自動再生特化)
      if (shortId || isShortsRoot || url.searchParams.has("shorts") || url.searchParams.has("short")) {
        const targetId = shortId || await getInitialShortIdFast();
        const data = await fetchFastShortWith3Next(targetId);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 3. コメント取得
      if (commentsVideoId) {
        const data = await fetchInvidiousComments(commentsVideoId, limit, continuation);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 4. 通常動画詳細 & 関連動画
      if (videoId) {
        const data = await fetchFastVideo(videoId, limit, continuation);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 5. チャンネル情報 & 動画一覧
      if (channelId || (continuation && path.includes("/channels"))) {
        const data = await fetchInvidiousChannel(channelId || "", limit, continuation);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 6. プレイリスト情報
      if (playlistId) {
        const data = await fetchInvidiousPlaylist(playlistId, limit);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // 7. 検索
      if (query || continuation || path.startsWith("/api/v1/search")) {
        const data = await fetchFastSearch(query || "", limit, continuation);
        setCache(cacheKey, data);
        return new Response(JSON.stringify(data), { headers: corsHeaders });
      }

      // デモ UI
      if (request.headers.get("Accept")?.includes("text/html")) {
        return new Response(renderDemoHtml(url.origin), {
          headers: { "Content-Type": "text/html; charset=utf-8" }
        });
      }

      return new Response(
        JSON.stringify({
          status: "ready",
          api: "Invidious-Compatible Ultra Engine v8 (Turbo Shorts & AutoPlay)",
          endpoints: [
            "/api/v1/shorts/:id",
            "/api/v1/search?q=:query",
            "/api/v1/channels/:id",
            "/api/v1/trending",
            "/api/v1/videos/:id",
            "/api/v1/comments/:id",
            "/api/v1/playlists/:id"
          ]
        }),
        { status: 200, headers: corsHeaders }
      );

    } catch (e) {
      return new Response(
        JSON.stringify({ error: e.message }),
        { status: 500, headers: corsHeaders }
      );
    }
  }
};

// =======================================================
// InnerTube 共通通信エンジン
// =======================================================
const INNERTUBE_API_KEY = "AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8";

async function callInnerTube(endpoint, payload) {
  const res = await fetch(`https://www.youtube.com/youtubei/v1/${endpoint}?key=${INNERTUBE_API_KEY}`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "X-YouTube-Client-Name": "1",
      "X-YouTube-Client-Version": "2.20240401.00.00",
      "Accept-Encoding": "gzip, deflate, br"
    },
    body: JSON.stringify({
      context: {
        client: {
          hl: "ja",
          gl: "JP",
          clientName: "WEB",
          clientVersion: "2.20240401.00.00"
        }
      },
      ...payload
    })
  });

  if (!res.ok) {
    const errText = await res.text();
    throw new Error(`YouTube API Error: HTTP ${res.status} - ${errText.slice(0, 100)}`);
  }
  return await res.json();
}

function makeShortEmbedUrl(videoId) {
  // playsinline=1, autoplay=1, mute=1, rel=0, loop=1 で確実なインライン自動ループ再生を実現
  return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&playsinline=1&enablejsapi=1&rel=0&iv_load_policy=3&modestbranding=1`;
}

function extractContinuationToken(data) {
  let token = null;
  function findToken(o, depth = 0) {
    if (!o || typeof o !== "object" || token || depth > 25) return;
    if (o.continuationItemRenderer) {
      const cir = o.continuationItemRenderer;
      token = cir.continuationEndpoint?.continuationCommand?.token ||
              cir.button?.buttonRenderer?.command?.continuationEndpoint?.continuationCommand?.token || null;
      if (token) return;
    }
    if (o.continuationCommand?.token) {
      token = o.continuationCommand.token;
      return;
    }
    if (Array.isArray(o)) {
      for (const item of o) {
        if (token) break;
        findToken(item, depth + 1);
      }
    } else {
      for (const k of Object.keys(o)) {
        if (token) break;
        if (k !== "trackingParams" && k !== "serviceTrackingParams") findToken(o[k], depth + 1);
      }
    }
  }
  findToken(data);
  return token;
}

function extractSearchContinuation(data) {
  const actions = data.onResponseReceivedCommands || data.onResponseReceivedActions;
  if (actions) {
    for (const act of actions) {
      const items = act.appendContinuationItemsAction?.continuationItems || [];
      for (let i = items.length - 1; i >= 0; i--) {
        const it = items[i];
        if (it.continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
          return it.continuationItemRenderer.continuationEndpoint.continuationCommand.token;
        }
      }
    }
  }
  const secList = data.contents?.twoColumnSearchResultsRenderer?.primaryContents?.sectionListRenderer?.contents;
  if (Array.isArray(secList)) {
    for (let i = secList.length - 1; i >= 0; i--) {
      const item = secList[i];
      if (item.continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
        return item.continuationItemRenderer.continuationEndpoint.continuationCommand.token;
      }
    }
  }
  return null;
}

function extractChannelContinuation(data) {
  const actions = data.onResponseReceivedActions || data.onResponseReceivedCommands;
  if (actions) {
    for (const act of actions) {
      const items = act.appendContinuationItemsAction?.continuationItems || [];
      for (let i = items.length - 1; i >= 0; i--) {
        const it = items[i];
        if (it.continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
          return it.continuationItemRenderer.continuationEndpoint.continuationCommand.token;
        }
      }
    }
  }
  function findInGrid(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || depth > 20) return null;
    if (obj.richGridRenderer?.contents) {
      const contents = obj.richGridRenderer.contents;
      for (let i = contents.length - 1; i >= 0; i--) {
        if (contents[i].continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
          return contents[i].continuationItemRenderer.continuationEndpoint.continuationCommand.token;
        }
      }
    }
    if (Array.isArray(obj)) {
      for (const it of obj) {
        const res = findInGrid(it, depth + 1);
        if (res) return res;
      }
    } else {
      for (const k of Object.keys(obj)) {
        if (k !== "trackingParams" && k !== "serviceTrackingParams") {
          const res = findInGrid(obj[k], depth + 1);
          if (res) return res;
        }
      }
    }
    return null;
  }
  return findInGrid(data);
}

// =======================================================
// ★ 1. 日本トレンド・急上昇取得
// =======================================================
async function fetchTrendingVideosReliable(type = "default") {
  const results = [];
  const seenIds = new Set();
  let trendQuery = "急上昇 日本";
  if (type === "music") trendQuery = "急上昇 音楽 日本";
  else if (type === "gaming") trendQuery = "急上昇 ゲーム 日本";

  try {
    const searchData = await callInnerTube("search", { query: trendQuery });
    function traverseTrending(obj, depth = 0) {
      if (!obj || typeof obj !== "object" || results.length >= 40 || depth > 30) return;
      const v = extractVideoRenderer(obj);
      if (v && v.videoId && !seenIds.has(v.videoId)) {
        seenIds.add(v.videoId);
        results.push({
          type: v.isShort ? "short" : "video",
          isShort: v.isShort,
          title: v.title,
          videoId: v.videoId,
          author: v.author,
          authorId: v.authorId,
          authorUrl: v.authorUrl,
          videoThumbnails: v.videoThumbnails,
          viewCount: v.viewCount,
          viewCountText: v.viewCountText,
          publishedText: v.publishedText,
          lengthSeconds: v.lengthSeconds,
          embedUrl: v.embedUrl
        });
      }
      if (Array.isArray(obj)) {
        for (const item of obj) traverseTrending(item, depth + 1);
      } else {
        for (const k of Object.keys(obj)) {
          if (k !== "trackingParams" && k !== "serviceTrackingParams") traverseTrending(obj[k], depth + 1);
        }
      }
    }
    traverseTrending(searchData);
  } catch (e) {}

  return results;
}

// =======================================================
// ★ 2. ショート動画エンジン (超高速1本化 & 1パス走査)
// =======================================================
async function getInitialShortIdFast() {
  return "9f1rHt0W_Ak";
}

async function fetchFastShortWith3Next(videoId) {
  // player は叩かず next エンドポイント1本だけで高速完結（レイテンシ半減）
  const nextData = await callInnerTube("next", { videoId });

  let title = "";
  let author = "";
  let authorId = "";
  let authorThumbnails = [];
  let likeCount = "高評価";
  const next3Videos = [];
  const seenIds = new Set([videoId]);

  // 単一の再帰パス（Single-pass）でタイトル・投稿者・いいね・次動画をまとめて抽出
  function traverseShort(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || depth > 25) return;

    // タイトル抽出
    if (!title && obj.videoPrimaryInfoRenderer?.title) {
      title = obj.videoPrimaryInfoRenderer.title.runs?.map(r => r.text).join("") ||
              obj.videoPrimaryInfoRenderer.title.simpleText || "";
    }

    // チャンネル・投稿者情報
    if (obj.videoSecondaryInfoRenderer) {
      const owner = obj.videoSecondaryInfoRenderer.owner?.videoOwnerRenderer;
      if (owner) {
        if (!author) author = owner.title?.runs?.[0]?.text || "";
        if (!authorId) authorId = owner.navigationEndpoint?.browseEndpoint?.browseId || "";
        if (authorThumbnails.length === 0 && owner.thumbnail?.thumbnails) {
          authorThumbnails = owner.thumbnail.thumbnails.map(t => ({
            url: fixUrl(t.url),
            width: t.width || 48,
            height: t.height || 48
          }));
        }
      }
    }

    // いいね数
    if (likeCount === "高評価") {
      if (obj.segmentedLikeDislikeButtonViewModel || obj.likeButtonViewModel) {
        const btn = obj.segmentedLikeDislikeButtonViewModel?.likeButtonViewModel?.likeButtonViewModel || obj.likeButtonViewModel;
        const txt = btn?.toggleButtonViewModel?.toggleButtonViewModel?.defaultButtonViewModel?.buttonViewModel?.title || "";
        if (txt) likeCount = txt;
      } else if (obj.toggleButtonRenderer?.defaultText) {
        const t = obj.toggleButtonRenderer.defaultText;
        const txt = t.simpleText || t.runs?.map(r => r.text).join("") || "";
        if (txt && !txt.includes("高評価") && !txt.includes("Like")) likeCount = txt;
      }
    }

    // 次の厳選3本動画
    if (next3Videos.length < 3) {
      const v = extractVideoRenderer(obj);
      if (v && v.videoId && !seenIds.has(v.videoId)) {
        seenIds.add(v.videoId);
        next3Videos.push({
          id: v.videoId,
          title: v.title,
          author: v.author || "YouTube Creator",
          thumbnail: `https://i.ytimg.com/vi/${v.videoId}/oardefault.jpg`,
          embedUrl: makeShortEmbedUrl(v.videoId)
        });
      }
    }

    if (Array.isArray(obj)) {
      for (let i = 0; i < obj.length; i++) {
        if (next3Videos.length >= 3 && title && author && likeCount !== "高評価") break;
        traverseShort(obj[i], depth + 1);
      }
    } else {
      for (const k of Object.keys(obj)) {
        if (next3Videos.length >= 3 && title && author && likeCount !== "高評価") break;
        if (k !== "trackingParams" && k !== "serviceTrackingParams") traverseShort(obj[k], depth + 1);
      }
    }
  }

  traverseShort(nextData);

  const embedUrl = makeShortEmbedUrl(videoId);

  return {
    status: "success",
    type: "shorts",
    current: {
      id: videoId,
      title: title || "Shorts",
      author: author || "YouTube Creator",
      authorId: authorId,
      authorUrl: authorId ? `/channel/${authorId}` : "",
      authorThumbnails: authorThumbnails.length > 0 ? authorThumbnails : [{ url: "https://www.gstatic.com/youtube/img/creator/avatar/creator_avatar_default.png", width: 48, height: 48 }],
      likeCount: likeCount,
      commentCount: "コメント",
      embedUrl: embedUrl,
      videoThumbnails: makeShortsThumbnails(videoId)
    },
    sequence: next3Videos
  };
}

function makeShortsThumbnails(videoId) {
  return [
    { quality: "vertical", url: `https://i.ytimg.com/vi/${videoId}/oardefault.jpg`, width: 720, height: 1280 },
    { quality: "hq", url: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`, width: 480, height: 360 }
  ];
}

// =======================================================
// ★ 3. 通常動画詳細 & 関連動画
// =======================================================
async function fetchFastVideo(videoId, limit = 15, continuationToken = null) {
  const payload = continuationToken ? { continuation: continuationToken } : { videoId: videoId };
  const nextData = await callInnerTube("next", payload);

  let primaryInfo = null;
  let secondaryInfo = null;
  const recommendedVideos = [];
  const seenIds = new Set();
  const nextContinuation = extractContinuationToken(nextData);

  function traverse(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || depth > 30) return;

    if (obj.videoPrimaryInfoRenderer) primaryInfo = obj.videoPrimaryInfoRenderer;
    if (obj.videoSecondaryInfoRenderer) secondaryInfo = obj.videoSecondaryInfoRenderer;

    if (recommendedVideos.length < limit) {
      const v = extractVideoRenderer(obj);
      if (v && v.videoId && v.videoId !== videoId && !seenIds.has(v.videoId)) {
        seenIds.add(v.videoId);
        recommendedVideos.push(v);
      }
    }

    if (Array.isArray(obj)) {
      for (const item of obj) {
        if (recommendedVideos.length >= limit && primaryInfo && secondaryInfo) break;
        traverse(item, depth + 1);
      }
    } else {
      for (const k of Object.keys(obj)) {
        if (recommendedVideos.length >= limit && primaryInfo && secondaryInfo) break;
        if (k !== "trackingParams" && k !== "serviceTrackingParams") traverse(obj[k], depth + 1);
      }
    }
  }

  traverse(nextData);

  const channelOwner = secondaryInfo?.owner?.videoOwnerRenderer;
  return {
    type: "video",
    title: primaryInfo?.title?.runs?.map(r => r.text).join("") || "",
    videoId: videoId,
    videoThumbnails: makeThumbnails(videoId),
    description: secondaryInfo?.attributedDescription?.content || secondaryInfo?.description?.runs?.map(r => r.text).join("") || "",
    descriptionHtml: escapeHtml(secondaryInfo?.attributedDescription?.content || "").replace(/\n/g, "<br>"),
    publishedText: primaryInfo?.dateText?.simpleText || "",
    viewCount: parseCount(primaryInfo?.viewCount?.videoViewCountRenderer?.viewCount?.simpleText || ""),
    author: channelOwner?.title?.runs?.[0]?.text || "",
    authorId: channelOwner?.navigationEndpoint?.browseEndpoint?.browseId || "",
    authorUrl: channelOwner?.navigationEndpoint?.browseEndpoint?.browseId ? `/channel/${channelOwner.navigationEndpoint.browseEndpoint.browseId}` : "",
    authorThumbnails: (channelOwner?.thumbnail?.thumbnails || []).map(t => ({ url: fixUrl(t.url), width: t.width || 48, height: t.height || 48 })),
    subCountText: channelOwner?.subscriberCountText?.simpleText || "",
    embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1`,
    recommendedVideos: recommendedVideos,
    continuation: nextContinuation
  };
}

// =======================================================
// ★ 4. 検索 (/api/v1/search?q=...)
// =======================================================
async function fetchFastSearch(query, limit = 30, continuationToken = null) {
  const payload = continuationToken ? { continuation: continuationToken } : { query: query };
  const data = await callInnerTube("search", payload);

  const nextContinuation = extractSearchContinuation(data);
  const results = [];
  const seenIds = new Set();

  function traverse(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || results.length >= limit || depth > 30) return;

    const v = extractVideoRenderer(obj);
    if (v && v.videoId && !seenIds.has(v.videoId)) {
      seenIds.add(v.videoId);
      results.push({
        type: v.isShort ? "short" : "video",
        isShort: v.isShort,
        title: v.title,
        videoId: v.videoId,
        author: v.author,
        authorId: v.authorId,
        authorUrl: v.authorUrl,
        videoThumbnails: v.videoThumbnails,
        viewCount: v.viewCount,
        viewCountText: v.viewCountText,
        publishedText: v.publishedText,
        lengthSeconds: v.lengthSeconds,
        embedUrl: v.embedUrl
      });
    }

    if (obj.playlistRenderer) {
      const pr = obj.playlistRenderer;
      const plId = pr.playlistId;
      if (plId && !seenIds.has(plId)) {
        seenIds.add(plId);
        results.push({
          type: "playlist",
          title: pr.title?.simpleText || pr.title?.runs?.map(r => r.text).join("") || "Playlist",
          playlistId: plId,
          author: pr.shortBylineText?.runs?.[0]?.text || pr.longBylineText?.runs?.[0]?.text || "",
          authorId: pr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || "",
          videoCount: parseCount(pr.videoCount || "0"),
          thumbnail: fixUrl(pr.thumbnails?.[0]?.thumbnails?.[0]?.url || `https://i.ytimg.com/vi/${pr.navigationEndpoint?.watchEndpoint?.videoId}/hqdefault.jpg`)
        });
      }
    }

    if (Array.isArray(obj)) {
      for (const item of obj) {
        if (results.length >= limit) break;
        traverse(item, depth + 1);
      }
    } else {
      for (const k of Object.keys(obj)) {
        if (results.length >= limit) break;
        if (k !== "trackingParams" && k !== "serviceTrackingParams") traverse(obj[k], depth + 1);
      }
    }
  }

  traverse(data);

  return {
    results: results,
    continuation: nextContinuation
  };
}

// =======================================================
// ★ 5. チャンネル情報 & 動画一覧 (/api/v1/channels/:id)
// =======================================================
async function fetchInvidiousChannel(channelInput, limit = 30, continuationToken = null) {
  let browseData = null;
  let channelId = channelInput;

  if (continuationToken) {
    browseData = await callInnerTube("browse", { continuation: continuationToken });
  } else {
    if (channelInput.startsWith("UC") && channelInput.length === 24) {
      try {
        browseData = await callInnerTube("browse", { browseId: channelId, params: "Egl2aWRlb3PyBgQKAjoA" });
      } catch (e) {}
    } else {
      const targetVideosUrl = `https://www.youtube.com/${channelInput.startsWith("@") ? channelInput : "@" + channelInput}/videos?hl=ja&gl=JP`;
      try {
        const res = await fetch(targetVideosUrl, {
          headers: { "User-Agent": "Mozilla/5.0", "Accept-Language": "ja,en-US;q=0.9" }
        });
        if (res.ok) {
          const html = await res.text();
          const marker = "ytInitialData = ";
          const idx = html.indexOf(marker);
          if (idx !== -1) {
            const slice = html.slice(idx + marker.length, idx + marker.length + 350000);
            const endIdx = slice.indexOf(";</script>");
            if (endIdx !== -1) {
              browseData = JSON.parse(slice.slice(0, endIdx));
              channelId = browseData.metadata?.channelMetadataRenderer?.externalId || channelId;
            }
          }
        }
      } catch (e) {}
    }

    if (!browseData) {
      browseData = await callInnerTube("browse", { browseId: channelId });
    }
  }

  if (!browseData) throw new Error("チャンネルデータを読み込めませんでした");

  const nextContinuation = extractChannelContinuation(browseData);

  let author = "";
  let subCountText = "";
  let description = browseData.metadata?.channelMetadataRenderer?.description || "";
  let authorThumbnails = [];
  let authorBanners = [];

  if (!continuationToken) {
    if (browseData.header?.pageHeaderRenderer) {
      const phr = browseData.header.pageHeaderRenderer;
      author = phr.pageTitle || "";
      const vm = phr.content?.pageHeaderViewModel;
      if (vm) {
        const a = vm.image?.decoratedAvatarViewModel?.avatar?.avatarViewModel?.image?.sources || [];
        if (a.length > 0) authorThumbnails = a.map(s => ({ url: fixUrl(s.url), width: s.width || 512, height: s.height || 512 }));
        const b = vm.banner?.imageBannerViewModel?.image?.sources || [];
        if (b.length > 0) authorBanners = b.map(s => ({ url: fixUrl(s.url), width: s.width || 1280, height: s.height || 720 }));
        (vm.metadata?.contentMetadataViewModel?.metadataRows || []).forEach(row => {
          (row.metadataParts || []).forEach(part => {
            const txt = part.text?.content || "";
            if (txt.includes("登録者") || txt.toLowerCase().includes("subscriber")) subCountText = txt;
          });
        });
      }
    }

    if (!author && browseData.header?.c4TabbedHeaderRenderer) {
      const c4 = browseData.header.c4TabbedHeaderRenderer;
      author = c4.title || "";
      subCountText = c4.subscriberCountText?.simpleText || "";
      authorThumbnails = (c4.avatar?.thumbnails || []).map(t => ({ url: fixUrl(t.url), width: t.width || 100, height: t.height || 100 }));
      authorBanners = (c4.banner?.thumbnails || []).map(t => ({ url: fixUrl(t.url), width: t.width || 1280, height: t.height || 720 }));
    }

    if (!author) author = browseData.metadata?.channelMetadataRenderer?.title || channelId;
  }

  const latestVideos = [];
  const seenIds = new Set();

  function traverse(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || latestVideos.length >= limit || depth > 30) return;

    const v = extractVideoRenderer(obj);
    if (v && v.videoId && !seenIds.has(v.videoId)) {
      seenIds.add(v.videoId);
      v.author = author || v.author;
      v.authorId = channelId;
      v.authorUrl = `/channel/${channelId}`;
      latestVideos.push(v);
    }

    if (Array.isArray(obj)) {
      for (const item of obj) {
        if (latestVideos.length >= limit) break;
        traverse(item, depth + 1);
      }
    } else {
      for (const key of Object.keys(obj)) {
        if (latestVideos.length >= limit) break;
        if (key !== "trackingParams" && key !== "serviceTrackingParams") traverse(obj[key], depth + 1);
      }
    }
  }

  traverse(browseData);

  return {
    author: author,
    authorId: channelId,
    authorUrl: `/channel/${channelId}`,
    authorThumbnails: authorThumbnails,
    authorBanners: authorBanners,
    subCount: parseCount(subCountText),
    totalViews: 0,
    joined: 0,
    autoGenerated: false,
    isFamilyFriendly: true,
    description: description,
    descriptionHtml: escapeHtml(description).replace(/\n/g, "<br>"),
    allowedRegions: ["JP", "US"],
    tabs: ["videos", "shorts", "playlists", "community"],
    latestVideos: latestVideos,
    continuation: nextContinuation
  };
}

// =======================================================
// コメント・プレイリスト
// =======================================================
async function fetchInvidiousComments(videoId, limit = 50, continuationToken = null) {
  let commentToken = continuationToken;

  if (!commentToken) {
    const nextData = await callInnerTube("next", { videoId });
    const mainContents = nextData.contents?.twoColumnWatchNextResults?.results?.results?.contents;

    function findToken(o, depth = 0) {
      if (!o || typeof o !== "object" || commentToken || depth > 20) return;
      if (o.continuationCommand?.token) {
        commentToken = o.continuationCommand.token;
        return;
      }
      if (Array.isArray(o)) o.forEach(item => findToken(item, depth + 1));
      else Object.keys(o).forEach(k => { if (k !== "trackingParams") findToken(o[k], depth + 1); });
    }

    findToken(mainContents);
    if (!commentToken) findToken(nextData);
  }

  if (!commentToken) return { commentCount: 0, videoId, comments: [], continuation: null };

  const commentData = await callInnerTube("next", { continuation: commentToken });
  const nextContinuation = extractContinuationToken(commentData);

  let commentCount = 0;
  const comments = [];
  const seenIds = new Set();
  const mutationsMap = new Map();
  if (commentData.frameworkUpdates?.entityBatchUpdate?.mutations) {
    for (const m of commentData.frameworkUpdates.entityBatchUpdate.mutations) {
      if (m.payload?.commentEntityPayload) mutationsMap.set(m.entityKey, m.payload.commentEntityPayload);
    }
  }

  function traverse(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || comments.length >= limit || depth > 25) return;

    if (obj.commentsHeaderRenderer) {
      const chr = obj.commentsHeaderRenderer;
      const txt = chr.countText?.runs?.map(r => r.text).join("") || chr.countText?.simpleText || "";
      const num = parseInt(txt.replace(/[^0-9]/g, ""), 10);
      if (!isNaN(num)) commentCount = num;
    }

    if (obj.commentViewModel) {
      const cvm = obj.commentViewModel.commentViewModel || obj.commentViewModel;
      const commentId = cvm.commentId || cvm.commentKey;

      if (commentId && !seenIds.has(commentId)) {
        let payload = null;
        for (const [k, p] of mutationsMap.entries()) {
          if (k.includes(commentId) || (cvm.commentKey && k === cvm.commentKey)) { payload = p; break; }
        }

        const content = payload?.properties?.content?.content || cvm.contentText?.content || cvm.contentText?.runs?.map(r => r.text).join("") || "";
        const author = payload?.author?.displayName || cvm.authorText?.content || cvm.authorText?.simpleText || "";
        let avatarUrl = payload?.author?.avatarThumbnailUrl || "";
        if (!avatarUrl) {
          const thumbs = cvm.authorThumbnail?.image?.sources || cvm.authorThumbnail?.thumbnails || [];
          if (thumbs.length > 0) avatarUrl = thumbs[thumbs.length - 1].url;
        }
        avatarUrl = fixUrl(avatarUrl);

        const authorId = payload?.author?.channelId || cvm.authorEndpoint?.browseEndpoint?.browseId || "";
        const publishedText = payload?.properties?.publishedTime || cvm.publishedTime || cvm.publishedTimeText?.runs?.[0]?.text || "";
        const likeStr = payload?.toolbar?.likeCountNotSelected || cvm.toolbar?.commentToolbarViewModel?.likeCountNotSelectedText || "0";

        if (content || author) {
          seenIds.add(commentId);
          comments.push({
            author, authorUrl: authorId ? `/channel/${authorId}` : "", authorId,
            authorThumbnails: avatarUrl ? [{ url: avatarUrl, width: 48, height: 48 }] : [],
            commentId, authorIsChannelOwner: !!cvm.authorIsChannelOwner,
            content, contentHtml: escapeHtml(content).replace(/\n/g, "<br>"),
            published: 0, publishedText, likeCount: parseCount(likeStr),
            replyCount: cvm.replyCount || 0, isPinned: !!cvm.pinnedCommentBadge
          });
        }
      }
    }

    if (obj.commentRenderer) {
      const cr = obj.commentRenderer;
      if (cr.commentId && !seenIds.has(cr.commentId)) {
        seenIds.add(cr.commentId);
        const content = cr.contentText?.runs?.map(r => r.text).join("") || cr.contentText?.simpleText || "";
        const author = cr.authorText?.simpleText || cr.authorText?.runs?.map(r => r.text).join("") || "";
        const authorId = cr.authorEndpoint?.browseEndpoint?.browseId || "";
        const thumbs = (cr.authorThumbnail?.thumbnails || []).map(t => ({ url: fixUrl(t.url), width: t.width || 48, height: t.height || 48 }));

        comments.push({
          author, authorUrl: authorId ? `/channel/${authorId}` : "", authorId,
          authorThumbnails: thumbs, commentId: cr.commentId, authorIsChannelOwner: !!cr.authorIsChannelOwner,
          content, contentHtml: escapeHtml(content).replace(/\n/g, "<br>"),
          published: 0, publishedText: cr.publishedTimeText?.runs?.[0]?.text || "",
          likeCount: parseCount(cr.voteCount?.simpleText || "0"), replyCount: cr.replyCount || 0, isPinned: !!cr.pinnedCommentBadge
        });
      }
    }

    if (Array.isArray(obj)) {
      for (const item of obj) traverse(item, depth + 1);
    } else {
      for (const k of Object.keys(obj)) {
        if (k !== "trackingParams") traverse(obj[k], depth + 1);
      }
    }
  }

  traverse(commentData);

  return { commentCount: commentCount || comments.length, videoId, comments, continuation: nextContinuation };
}

async function fetchInvidiousPlaylist(playlistInput, limit = 50) {
  const cleanId = playlistInput.replace(/^VL/, "");
  const browseId = "VL" + cleanId;
  let browseData = null;

  try {
    const plUrl = `https://www.youtube.com/playlist?list=${cleanId}&hl=ja&gl=JP`;
    const res = await fetch(plUrl, { headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" } });
    if (res.ok) {
      const html = await res.text();
      const marker = "ytInitialData = ";
      const idx = html.indexOf(marker);
      if (idx !== -1) {
        let slice = html.slice(idx + marker.length);
        const endIdx = slice.indexOf(";</script>");
        if (endIdx !== -1) {
          slice = slice.slice(0, endIdx);
          try { browseData = JSON.parse(slice); } catch(e){}
        }
      }
    }
  } catch (e) {}

  if (!browseData) {
    try { browseData = await callInnerTube("browse", { browseId }); } catch (e) {}
  }
  if (!browseData) throw new Error("プレイリスト情報を読み込めませんでした");

  const plHeader = browseData.header?.playlistHeaderRenderer;
  const sidebar = browseData.sidebar?.playlistSidebarRenderer?.items;
  const primarySidebar = sidebar?.[0]?.playlistSidebarPrimaryInfoRenderer;
  const secondarySidebar = sidebar?.[1]?.playlistSidebarSecondaryInfoRenderer?.videoOwner?.videoOwnerRenderer;

  const title = plHeader?.title?.simpleText || plHeader?.title?.runs?.map(r => r.text).join("") || primarySidebar?.title?.runs?.map(r => r.text).join("") || "";
  const author = plHeader?.ownerText?.runs?.[0]?.text || secondarySidebar?.title?.runs?.[0]?.text || "";
  const authorId = plHeader?.ownerText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || secondarySidebar?.navigationEndpoint?.browseEndpoint?.browseId || "";
  const authorThumbnails = (secondarySidebar?.thumbnail?.thumbnails || []).map(t => ({ url: fixUrl(t.url), width: t.width || 48, height: t.height || 48 }));
  const description = plHeader?.descriptionText?.simpleText || primarySidebar?.description?.simpleText || "";
  const videoCountText = plHeader?.numVideosText?.runs?.map(r => r.text).join("") || primarySidebar?.stats?.[0]?.runs?.map(r => r.text).join("") || "";

  const videos = [];
  const seenIds = new Set();
  let indexCounter = 0;

  function traverse(obj, depth = 0) {
    if (!obj || typeof obj !== "object" || videos.length >= limit || depth > 20) return;

    if (obj.playlistVideoRenderer) {
      const pvr = obj.playlistVideoRenderer;
      if (pvr.videoId && !seenIds.has(pvr.videoId)) {
        seenIds.add(pvr.videoId);
        videos.push({
          title: pvr.title?.runs?.map(r => r.text).join("") || pvr.title?.simpleText || "",
          videoId: pvr.videoId,
          author: pvr.shortBylineText?.runs?.[0]?.text || author,
          authorId: pvr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || authorId,
          authorUrl: `/channel/${authorId}`,
          videoThumbnails: makeThumbnails(pvr.videoId),
          index: indexCounter++,
          lengthSeconds: parseLengthToSeconds(pvr.lengthText?.simpleText || "")
        });
      }
    }

    if (Array.isArray(obj)) {
      for (const item of obj) traverse(item, depth + 1);
    } else {
      for (const k of Object.keys(obj)) {
        if (k !== "trackingParams") traverse(obj[k], depth + 1);
      }
    }
  }
  traverse(browseData);

  return {
    title, playlistId: cleanId, author, authorId, authorUrl: authorId ? `/channel/${authorId}` : "",
    authorThumbnails, description, descriptionHtml: escapeHtml(description).replace(/\n/g, "<br>"),
    videoCount: parseCount(videoCountText) || videos.length, viewCount: 0, updated: 0, isListed: true, videos
  };
}

// =======================================================
// 動画抽出パーサー
// =======================================================
function extractVideoRenderer(obj) {
  if (!obj || typeof obj !== "object") return null;

  if (obj.richItemRenderer && obj.richItemRenderer.content) {
    obj = obj.richItemRenderer.content;
  }

  const vr = obj.compactVideoRenderer || obj.videoRenderer || obj.gridVideoRenderer || obj.playlistVideoRenderer ||
             (obj.videoId && (obj.title || obj.headline) ? obj : null);

  if (vr && vr.videoId && typeof vr.videoId === "string" && vr.videoId.length === 11) {
    const videoId = vr.videoId;
    const lengthText = vr.lengthText?.simpleText || vr.thumbnailOverlays?.[0]?.thumbnailOverlayTimeStatusRenderer?.text?.simpleText || "";
    const lengthSeconds = parseLengthToSeconds(lengthText);
    const title = vr.title?.runs?.map(r => r.text).join("") || vr.title?.simpleText || "";
    const isShort = (lengthSeconds > 0 && lengthSeconds <= 61) || title.toLowerCase().includes("#shorts");

    return {
      videoId: videoId,
      isShort: isShort,
      title: title,
      author: vr.shortBylineText?.runs?.[0]?.text || vr.ownerText?.runs?.[0]?.text || "",
      authorId: vr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || vr.ownerText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || "",
      authorUrl: vr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId ? `/channel/${vr.shortBylineText.runs[0].navigationEndpoint.browseEndpoint.browseId}` : "",
      videoThumbnails: makeThumbnails(videoId),
      lengthSeconds: lengthSeconds,
      viewCountText: vr.viewCountText?.simpleText || vr.viewCountText?.runs?.map(r => r.text).join("") || "",
      viewCount: parseCount(vr.viewCountText?.simpleText || ""),
      publishedText: vr.publishedTimeText?.simpleText || vr.publishedTimeText?.runs?.[0]?.text || "",
      embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1`
    };
  }

  const lvm = obj.lockupViewModel || (obj.contentId && obj.metadata ? obj : null);
  if (lvm) {
    const videoId = lvm.contentId || lvm.rendererContext?.commandContext?.onTap?.innertubeCommand?.watchEndpoint?.videoId;
    if (videoId && typeof videoId === "string" && videoId.length === 11) {
      const meta = lvm.metadata?.lockupMetadataViewModel;
      const rows = meta?.metadataRows || [];
      const authorName = rows[0]?.metadataParts?.[0]?.text?.content || "";
      const viewTextStr = rows[1]?.metadataParts?.[0]?.text?.content || ""; 
      const publishedTextStr = rows[1]?.metadataParts?.[1]?.text?.content || "";
      const title = meta?.title?.content || "";
      let lengthText = "";
      const badges = lvm.contentImage?.thumbnailOverlayBadgeViewModel?.thumbnailBadges || [];
      for (const b of badges) {
        const bText = b.thumbnailBadgeViewModel?.text || "";
        if (bText && (bText.includes(":") || /^\d+$/.test(bText))) {
          lengthText = bText; break;
        }
      }
      const lengthSeconds = parseLengthToSeconds(lengthText);
      const isShort = lvm.contentType === "LOCKUP_CONTENT_TYPE_SHORTS" || (lengthSeconds > 0 && lengthSeconds <= 61) || title.toLowerCase().includes("#shorts");

      return {
        videoId: videoId,
        isShort: isShort,
        title: title,
        videoThumbnails: makeThumbnails(videoId),
        author: authorName,
        authorId: "", authorUrl: "",
        lengthSeconds: lengthSeconds,
        viewCountText: viewTextStr, viewCount: parseCount(viewTextStr), 
        publishedText: publishedTextStr,
        embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1`
      };
    }
  }

  if (obj.reelItemRenderer) {
    const r = obj.reelItemRenderer;
    const vId = r.videoId;
    if (vId) {
      return {
        videoId: vId, isShort: true,
        title: r.headline?.simpleText || r.headline?.runs?.map(x => x.text).join("") || "Shorts",
        author: r.channelTitleText?.simpleText || r.channelTitleText?.runs?.[0]?.text || "",
        authorId: "", authorUrl: "",
        videoThumbnails: makeThumbnails(vId),
        lengthSeconds: 30,
        viewCountText: r.viewCountText?.simpleText || "", viewCount: parseCount(r.viewCountText?.simpleText || ""),
        publishedText: "",
        embedUrl: makeShortEmbedUrl(vId)
      };
    }
  }

  return null;
}

function makeThumbnails(videoId) {
  return [
    { quality: "maxres", url: `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`, width: 1280, height: 720 },
    { quality: "hqdefault", url: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`, width: 480, height: 360 },
    { quality: "mqdefault", url: `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`, width: 320, height: 180 },
    { quality: "default", url: `https://i.ytimg.com/vi/${videoId}/default.jpg`, width: 120, height: 90 }
  ];
}

function parseLengthToSeconds(txt) {
  if (!txt) return 0;
  const parts = txt.split(":").map(p => parseInt(p, 10));
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  return 0;
}

function parseCount(txt) {
  if (!txt) return 0;
  const clean = txt.replace(/,/g, "").replace(/[^0-9.万億kmKM]/g, "");
  let mul = 1;
  if (clean.includes("万")) mul = 10000;
  if (clean.includes("億")) mul = 100000000;
  if (clean.toLowerCase().includes("k")) mul = 1000;
  if (clean.toLowerCase().includes("m")) mul = 1000000;
  const val = parseFloat(clean.replace(/[万億kmKM]/gi, ""));
  return isNaN(val) ? 0 : Math.round(val * mul);
}

function escapeHtml(str) {
  return (str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}

function fixUrl(url) {
  if (!url) return "";
  return url.startsWith("//") ? "https:" + url : url;
}

// =======================================================
// デモ UI (HTML / 先読みキャッシュ & 即時自動再生)
// =======================================================
function renderDemoHtml(origin) {
  return `<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>Invidious Turbo Engine</title>
  <style>
    body { font-family: sans-serif; background: #0f0f0f; color: #fff; padding: 20px; max-width: 980px; margin: 0 auto; }
    h1 { font-size: 20px; color: #00e5ff; }
    .tabs { display: flex; gap: 8px; margin-bottom: 15px; flex-wrap: wrap; }
    .tab-btn { padding: 8px 16px; background: #222; border: 1px solid #444; color: #fff; border-radius: 4px; cursor: pointer; }
    .tab-btn.active { background: #0070f3; border-color: #0070f3; font-weight: bold; }
    .input-box { display: flex; gap: 8px; margin-bottom: 15px; }
    input { flex: 1; padding: 10px; background: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 4px; font-family: monospace; }
    button.submit { padding: 10px 20px; background: #0070f3; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    #shortsTestView { display: none; margin-bottom: 20px; background: #181818; padding: 15px; border-radius: 8px; }
    .shorts-columns { display: flex; gap: 20px; flex-wrap: wrap; }
    .shorts-current-box { width: 280px; }
    .shorts-current { width: 280px; aspect-ratio: 9/16; background: #000; border-radius: 8px; overflow: hidden; position: relative; }
    .shorts-current iframe { width: 100%; height: 100%; border: none; }
    .shorts-controls { margin-top: 8px; display: flex; gap: 8px; }
    .shorts-controls button { flex: 1; padding: 6px; background: #333; border: 1px solid #555; color: #fff; border-radius: 4px; cursor: pointer; font-size: 12px; }
    .shorts-controls button:hover { background: #444; }
    .shorts-sequence-list { flex: 1; min-width: 250px; }
    .seq-card { display: flex; gap: 10px; margin-bottom: 8px; background: #222; padding: 8px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; transition: border-color 0.2s; }
    .seq-card:hover { border-color: #00e5ff; }
    .seq-card img { width: 45px; height: 80px; object-fit: cover; border-radius: 4px; }
    pre { background: #151515; padding: 12px; border-radius: 6px; overflow: auto; max-height: 450px; color: #00ff66; font-size: 12px; }
  </style>
</head>
<body>
  <h1>Invidious Turbo Engine v8 (爆速ショート & 自動再生)</h1>
  <div class="tabs">
    <button class="tab-btn" onclick="setMode('search')">🔍 検索</button>
    <button class="tab-btn" onclick="setMode('channel')">チャンネル</button>
    <button class="tab-btn" onclick="setMode('trending')">🔥 トレンド</button>
    <button class="tab-btn active" onclick="setMode('shorts')">📱 ショート (爆速 & 自動再生)</button>
    <button class="tab-btn" onclick="setMode('video')">通常動画</button>
    <button class="tab-btn" onclick="setMode('comments')">コメント一覧</button>
  </div>
  <div class="input-box">
    <input id="pathInput" type="text" value="/api/v1/shorts/9f1rHt0W_Ak">
    <button class="submit" onclick="fetchApi()">API実行</button>
    <button class="submit" id="btnNext" style="background:#28a745;display:none;" onclick="loadNextPage()">＋ 続きを読み込む</button>
  </div>

  <div id="shortsTestView">
    <div class="shorts-columns">
      <div class="shorts-current-box">
        <div class="shorts-current">
          <iframe
            id="shortsIframe"
            src=""
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            playsinline>
          </iframe>
        </div>
        <div class="shorts-controls">
          <button onclick="toggleMute()">🔊 音声 ON / OFF</button>
          <button onclick="playNextInSequence()">⏭ 次のショート</button>
        </div>
        <div style="margin-top:8px;">
          <b id="shortTitleDisplay" style="font-size:14px;"></b>
          <div id="shortAuthorDisplay" style="font-size:13px;color:#00e5ff;margin-top:2px;"></div>
          <div id="shortLikesDisplay" style="font-size:12px;color:#00ff66;margin-top:4px;"></div>
        </div>
      </div>
      <div class="shorts-sequence-list">
        <h4>↓ 次のショート動画 (クリックで0ms即時再生):</h4>
        <div id="sequenceList"></div>
      </div>
    </div>
  </div>

  <pre id="result">JSON結果がここに表示されます...</pre>

  <script>
    let currentMode = 'shorts';
    let lastNextToken = null;
    let isMuted = true;
    let currentSequence = [];
    const clientShortCache = new Map(); // 0ms切り替え用のローカル先読みキャッシュ

    const shortsIframe = document.getElementById('shortsIframe');

    // iframeロード完了時に postMessage を送信して確実に自動再生を発火
    shortsIframe.addEventListener('load', () => {
      try {
        shortsIframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
      } catch (e) {}
    });

    function toggleMute() {
      isMuted = !isMuted;
      const cmd = isMuted ? 'mute' : 'unMute';
      try {
        shortsIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: cmd, args: '' }), '*');
      } catch (e) {}
    }

    function setMode(m) {
      currentMode = m;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');
      const input = document.getElementById('pathInput');
      document.getElementById('btnNext').style.display = 'none';
      lastNextToken = null;
      if (m === 'search') input.value = '/api/v1/search?q=' + encodeURIComponent('米津玄師');
      if (m === 'channel') input.value = '/api/v1/channels/UCUCeZaZeJbEYAAzvMgrKOPQ';
      if (m === 'trending') input.value = '/api/v1/trending';
      if (m === 'shorts') input.value = '/api/v1/shorts/9f1rHt0W_Ak';
      if (m === 'video') input.value = '/api/v1/videos/SX_ViT4Ra7k';
      if (m === 'comments') input.value = '/api/v1/comments/SX_ViT4Ra7k';
    }

    async function playShortDirectly(id, preData = null) {
      document.getElementById('pathInput').value = '/api/v1/shorts/' + id;
      const shortsView = document.getElementById('shortsTestView');
      const shortTitle = document.getElementById('shortTitleDisplay');
      const shortAuthor = document.getElementById('shortAuthorDisplay');
      const shortLikes = document.getElementById('shortLikesDisplay');
      const embedUrl = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&mute=' + (isMuted ? '1' : '0') + '&controls=0&loop=1&playlist=' + id + '&playsinline=1&enablejsapi=1&rel=0';

      // 1. 先読みキャッシュがあれば 0ms で即座に iframe とタイトルを更新して再生開始！
      shortsView.style.display = 'block';
      shortsIframe.src = embedUrl;

      if (preData) {
        shortTitle.textContent = preData.title;
        shortAuthor.textContent = 'チャンネル: ' + (preData.author || '');
      }

      // 2. バックグラウンドで次のシーケンスをフェッチ
      fetchApi();
    }

    function playNextInSequence() {
      if (currentSequence && currentSequence.length > 0) {
        const next = currentSequence[0];
        playShortDirectly(next.id, next);
      }
    }

    async function fetchApi() {
      const p = document.getElementById('pathInput').value.trim();
      const resEl = document.getElementById('result');
      const shortsView = document.getElementById('shortsTestView');
      const shortTitle = document.getElementById('shortTitleDisplay');
      const shortAuthor = document.getElementById('shortAuthorDisplay');
      const shortLikes = document.getElementById('shortLikesDisplay');
      const seqList = document.getElementById('sequenceList');
      const btnNext = document.getElementById('btnNext');

      btnNext.style.display = 'none';
      lastNextToken = null;

      try {
        // 先読みキャッシュがある場合は即表示
        let json;
        if (clientShortCache.has(p)) {
          json = clientShortCache.get(p);
        } else {
          resEl.textContent = '読み込み中...';
          const res = await fetch('${origin}' + p);
          json = await res.json();
          clientShortCache.set(p, json);
        }

        resEl.textContent = JSON.stringify(json, null, 2);

        lastNextToken = json.continuation || null;
        if (lastNextToken) btnNext.style.display = 'inline-block';

        if (json.type === 'shorts' && json.current) {
          shortsView.style.display = 'block';
          if (shortsIframe.src !== json.current.embedUrl) {
            shortsIframe.src = json.current.embedUrl;
          }
          shortTitle.textContent = json.current.title;
          shortAuthor.textContent = 'チャンネル: ' + json.current.author;
          shortLikes.textContent = '👍 ' + (json.current.likeCount || '高評価');

          currentSequence = json.sequence || [];
          if (currentSequence.length > 0) {
            seqList.innerHTML = currentSequence.map(s => \`
              <div class="seq-card" onclick="playShortDirectly('\${s.id}', { title: '\${encodeURIComponent(s.title)}', author: '\${encodeURIComponent(s.author)}' })">
                <img src="\${s.thumbnail}">
                <div style="font-size:12px;">
                  <b>\${s.title || 'Shorts'}</b><br>
                  <span style="color:#aaa;">\${s.author || ''}</span><br>
                  <span style="color:#00e5ff;">▶ タップで即時再生</span>
                </div>
              </div>
            \`).join('');

            // 次の3本のAPIデータをバックグラウンドで先読み（プリフェッチ）
            currentSequence.forEach(s => {
              const nextUrl = '/api/v1/shorts/' + s.id;
              if (!clientShortCache.has(nextUrl)) {
                fetch('${origin}' + nextUrl).then(r => r.json()).then(data => {
                  clientShortCache.set(nextUrl, data);
                }).catch(() => {});
              }
            });
          }
        }
      } catch (err) {
        resEl.textContent = 'エラー: ' + err.message;
      }
    }

    async function loadNextPage() {
      if (!lastNextToken) return;
      const resEl = document.getElementById('result');
      resEl.textContent = '次ページを読み込み中...';

      let endpoint = '';
      if (currentMode === 'search') {
        endpoint = '/api/v1/search?continuation=' + encodeURIComponent(lastNextToken);
      } else if (currentMode === 'channel') {
        endpoint = '/api/v1/channels/UCUCeZaZeJbEYAAzvMgrKOPQ?continuation=' + encodeURIComponent(lastNextToken);
      }

      try {
        const res = await fetch('${origin}' + endpoint);
        const json = await res.json();
        resEl.textContent = JSON.stringify(json, null, 2);
        lastNextToken = json.continuation || null;
        if (!lastNextToken) document.getElementById('btnNext').style.display = 'none';
      } catch (e) {
        resEl.textContent = '追加読み込みエラー: ' + e.message;
      }
    }
  </script>
</body>
</html>`;
}
